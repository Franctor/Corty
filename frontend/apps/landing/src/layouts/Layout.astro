---
import '../styles/global.css';
import ClubModal from '../components/ClubModal.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Corty',
  description = 'Encuentra y reserva pistas de pádel, fútbol, tenis y más cerca de ti. Gestiona tus partidos y conecta con otros jugadores.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg width='56' height='56' viewBox='0 0 56 56' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M38.5 17C35.2 14 31 12.5 26.5 12.5C17.4 12.5 10 19.9 10 29C10 38.1 17.4 45.5 26.5 45.5C31 45.5 35.2 44 38.5 41' stroke='%2358CC02' stroke-width='3.8' stroke-linecap='round' fill='none'/%3E%3Cpath d='M26.5 22.5C30.2 22.5 33.2 25.4 33.2 29C33.2 32.6 30.2 35.5 26.5 35.5' stroke='%2358CC02' stroke-width='2' stroke-linecap='round' fill='none'/%3E%3C/svg%3E" />
  </head>
  <body class="select-none">
    <slot />
    <ClubModal />
  </body>
</html>
