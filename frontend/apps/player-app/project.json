{
  "name": "player-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/player-app/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/player-app",
        "browser": "apps/player-app/src/main.ts",
        "tsConfig": "apps/player-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/player-app/src/public",
            "output": "/"
          },
          {
            "glob": "**/*.svg",
            "input": "node_modules/ionicons/dist/ionicons/svg",
            "output": "./svg"
          },
          {
            "glob": "favicon.svg",
            "input": "libs/shared-ui/src/assets",
            "output": "/"
          },
          {
            "glob": "**/*.svg",
            "input": "libs/shared-ui/src/assets/sports",
            "output": "/assets/sports"
          }
        ],
        "styles": [
          "apps/player-app/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/player-app/src/environments/environment.ts",
              "with": "apps/player-app/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "player-app:build:production"
        },
        "development": {
          "buildTarget": "player-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/player-app/tsconfig.spec.json",
        "include": [
          "apps/player-app/src/**/*.spec.ts"
        ]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "player-app:build",
        "port": 4200,
        "staticFilePath": "dist/apps/player-app/browser",
        "spa": true
      }
    }
  }
}